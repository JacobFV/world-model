# Credentials used by worldmodel acquisition. Copy to `.env` (gitignored) and fill in.
# Values are read from the environment; `.env` never overrides variables already set.
# Never commit real values. Receipts and manifests redact these.

# api.data.gov key (https://api.data.gov/signup/) — FEC, Congress.gov and other data.gov APIs
DATA_GOV_API_KEY=
FEC_API_KEY=
CONGRESS_API_KEY=

# U.S. Census Data API (https://api.census.gov/data/key_signup.html; activate via email link)
CENSUS_API_KEY=

# Bureau of Economic Analysis (https://apps.bea.gov/API/signup/)
BEA_API_KEY=

# Bureau of Labor Statistics Public Data API v2 (https://data.bls.gov/registrationEngine/)
BLS_API_KEY=

# USDA NASS Quick Stats (https://quickstats.nass.usda.gov/api)
USDA_NASS_API_KEY=

# U.S. Energy Information Administration (https://www.eia.gov/opendata/register.php)
EIA_API_KEY=

# FRED / ALFRED (https://fredaccount.stlouisfed.org/apikeys)
FRED_API_KEY=

# SEC EDGAR requires a descriptive User-Agent with contact email, e.g. "Name email@example.com"
SEC_USER_AGENT=

# Uppsala Conflict Data Program API token (optional; bulk GED downloads need no token)
UCDP_ACCESS_TOKEN=

# Acquisition controls (optional; see docs/full-acquisition.md)
# WORLD_MODEL_DOWNLOAD_BUDGET=100GiB
# WORLD_MODEL_RAW_VERIFY=full

# BLS flat files (download.bls.gov) require a User-Agent with contact email
BLS_USER_AGENT=

# Market data (individual/internal use only; no redistribution)
# Massive (formerly Polygon) — https://massive.com/dashboard/signup
MASSIVE_API_KEY=
# Massive flat files (S3-compatible; bucket "flatfiles") — plan-dependent access
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
MASSIVE_S3_ENDPOINT=https://files.massive.com
# Alpaca free paper account — https://app.alpaca.markets/signup
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_API_ENDPOINT=https://paper-api.alpaca.markets/v2

# UN Comtrade (subscribe to "comtrade - v1") — https://comtradedeveloper.un.org/
COMTRADE_API_KEY=
COMTRADE_SECONDARY_KEY=

# Lobbying Disclosure Act API — https://lda.gov/api/register/
LDA_API_KEY=

# Optional: WTO timeseries — https://apiportal.wto.org/signup
WTO_API_KEY=
# Optional, approval-gated: ACLED (OAuth password grant) — https://acleddata.com/register/
ACLED_EMAIL=
ACLED_PASSWORD=
