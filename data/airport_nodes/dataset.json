{
  "id": "airport_nodes",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_ready",
  "description": "OurAirports global aviation reference: all airports, heliports and seaplane bases with coordinates, elevation and IATA/ICAO codes, runways (dimensions, surface, lighting), radio frequencies, navaids, and country/region jurisdictions; the sampling block keeps the bounded California medium/large airport excerpt",
  "source": {
    "publisher": "OurAirports community (David Megginson)",
    "license_status": "public_domain",
    "license": "Public Domain (The Unlicense / dedicated to the public domain by OurAirports)",
    "license_url": "https://ourairports.com/data/",
    "license_notes": "No warranty of accuracy; community-edited and not authoritative for navigation. No schedules or flights.",
    "release": "nightly export, retrieved 2026-09-15 from davidmegginson.github.io/ourairports-data"
  },
  "entrypoint": "pipeline.py:run",
  "parameters": {},
  "sampling": {
    "strategy": "download",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 65011712,
    "max_uncompressed_bytes": 65011712,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 25,
    "total_timeout_seconds": 90,
    "format": "csv",
    "representative": false,
    "url": "https://ourairports.com/data/airports.csv",
    "criteria": "First100 California medium/large airports; full CSV downloaded temporarily within62MiB then discarded; no flights or schedules",
    "documentation": "https://ourairports.com/help/data-dictionary.html",
    "required_pattern": {
      "iso_region": "US-CA",
      "type": "(?:large|medium)_airport"
    }
  },
  "acquisition": {
    "strategy": "files",
    "description": "Complete OurAirports global CSV set: airports, runways, navaids, airport frequencies, countries and regions (nightly public-domain export mirrored on GitHub Pages); one shard per file",
    "documentation": "https://ourairports.com/help/data-dictionary.html",
    "desired_bytes": 24000000,
    "min_bytes": 0,
    "priority": 3.0,
    "files": [
      {
        "url": "https://davidmegginson.github.io/ourairports-data/airports.csv",
        "name": "airports.csv"
      },
      {
        "url": "https://davidmegginson.github.io/ourairports-data/runways.csv",
        "name": "runways.csv"
      },
      {
        "url": "https://davidmegginson.github.io/ourairports-data/navaids.csv",
        "name": "navaids.csv"
      },
      {
        "url": "https://davidmegginson.github.io/ourairports-data/airport-frequencies.csv",
        "name": "airport-frequencies.csv"
      },
      {
        "url": "https://davidmegginson.github.io/ourairports-data/countries.csv",
        "name": "countries.csv"
      },
      {
        "url": "https://davidmegginson.github.io/ourairports-data/regions.csv",
        "name": "regions.csv"
      }
    ],
    "rate_limit": {
      "requests_per_second": 0.5
    },
    "timeout_seconds": 120,
    "retries": 5,
    "reader": {
      "format": "csv"
    }
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 3000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized"
}
