{
  "id": "calibration_reports",
  "schema_version": 2,
  "kind": "derived",
  "status": "published_by_estimation_layer",
  "description": "Validation reports and estimates published by worldmodel.estimation from normalized catalog datasets. Written by 'wm calibrate-all', not by a stage pipeline.",
  "dependencies": [],
  "entrypoint": "pipeline.py:run",
  "parameters": {
    "producer": "worldmodel.estimation.validation:validate_process",
    "plan": "worldmodel/estimation/real_data_plan.json",
    "command": "python3 -m worldmodel calibrate-all"
  },
  "stages": [
    {
      "id": "final",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "jsonl"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 100000
      },
      "cache": "off",
      "retention": "retain"
    }
  ],
  "output_stage": "final"
}
