      },
      "validation": {
        "allow_empty": false,
        "max_rows": 40000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "acquisition": {
    "strategy": "files",
    "description": "ASPEP Individual Unit Files, one zip per survey year 1993-2024. Each archive holds <yy>empid.txt (unit directory with FIPS state/county) and <yy>empst.txt (employment and payroll by item code), plus the year's technical documentation. Three publisher naming eras: <year>_downloadable_data.zip (1993-2014, 2016), <year>_individual_unit_files.zip (2015 under annual-apes, 2017-2021 and 2023-2024 flat) and '2022 COG-E Individual Unit Files.zip' for the 2022 Census of Governments. Measured sizes range from 1.5 MB (2005) to 37.7 MB (2017 Census of Governments). www2.census.gov applies a Cloudflare zone rate limit (error 1015, HTTP 429) to repeated requests, so this block spaces requests 10 s apart and backs off up to 10 minutes.",
    "documentation": "https://www.census.gov/programs-surveys/apes/data/datasets.html",
    "desired_bytes": 400000000,
    "min_bytes": 0,
    "priority": 3.0,
    "skip_statuses": [
      404
    ],
    "rate_limit": {
      "requests_per_second": 0.1
    },
    "timeout_seconds": 300,
    "retries": 12,
    "backoff_seconds": 20.0,
