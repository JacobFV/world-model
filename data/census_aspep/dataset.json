{
  "id": "census_aspep",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_configured",
  "description": "Census Annual Survey of Public Employment & Payroll individual-unit files, 1993-2024: every surveyed state and local government unit by functional category, with full-time and part-time employees and March payroll, reported/imputed data flags, and the FIPS state and county published in the unit ID file. Census of Governments years (1997, 2002, 2007, 2012, 2017, 2022) enumerate all governments; every other year samples local governments.",
  "source": {
    "publisher": "U.S. Census Bureau, Economy-Wide Statistics Division, Employment Statistics Branch",
    "license_status": "public_domain_us_government",
    "documentation": "https://www.census.gov/programs-surveys/apes/technical-documentation.html",
    "license_notes": "US federal government work: public domain in the United States (17 U.S.C. 105); no redistribution restriction; cite the publisher. Values carry a data flag saying whether they were reported by the respondent or imputed (technical documentation section 2.4); imputation is not suppression, so no cell is withheld. Non-census years are a probability sample of local governments, and the unit's probability of selection is published rather than a weight.",
    "person_level_records": {
      "policy": "prohibited",
      "authority": "13 U.S.C. 9",
      "note": "ASPEP publishes nothing about identified natural persons: the smallest published unit is a government and a functional category, not an employee. The restrictive default therefore costs this dataset nothing and no permission is claimed. Public payroll disclosure statutes are not engaged because the publisher never names anyone."
    }
  },
  "expected_outputs": [
    "government_employees",
    "government_payroll",
    "government_unit_population",
    "school_enrollment"
  ],
  "setup": "One shard per survey year, named aspep_<year>.zip so the pipeline reads the year deterministically. Parse the fixed-width ID and data members by column position; join to geography only through the published FIPS state and county.",
  "entrypoint": "pipeline.py:run",
  "output_stage": "normalized",
  "parameters": {},
  "sampling": {
    "strategy": "blocked",
    "reason": "Full acquisition only (wm acquire census_aspep): a 100-row excerpt of one fixed-width member cannot be parsed without its companion ID file, and the pipeline requires both members of each year's archive.",
    "criteria": "First 100 records, at most 1 MiB",
    "format": "jsonl",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864
  },
  "stages": [
    {
