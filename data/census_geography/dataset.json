{
  "id": "census_geography",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_configured",
  "description": "Census 2024 geography: Gazetteer entities (states, counties, CBSAs, CSAs, places, tracts, ZCTAs) with land/water area and internal points, hierarchy assertions, and compact 1:500k cartographic boundary polygons in a separate geometry stage",
  "source": {
    "publisher": "U.S. Census Bureau, Geography Division",
    "license_status": "public_domain",
    "documentation": "https://www.census.gov/geographies/mapping-files/time-series/geo/cartographic-boundary.html",
    "license_notes": "US federal government work: public domain in the United States (17 U.S.C. 105); no redistribution restriction; cite the publisher. Cartographic boundary (1:500k) files are generalized; use TIGER/Line for legal/precise boundaries."
  },
  "expected_outputs": [
    "location",
    "jurisdiction",
    "located_in"
  ],
  "setup": "Partition and decode geographic archives; preserve GEOID, geometry CRS and boundary vintage.",
  "entrypoint": "pipeline.py:run",
  "parameters": {},
  "sampling": {
    "strategy": "download",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 25,
    "total_timeout_seconds": 90,
    "format": "json",
    "records_path": [
      "features"
    ],
    "representative": false,
    "url": "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/State_County/MapServer/1/query?where=STATE%3D%2706%27&outFields=GEOID%2CNAME%2CSTATE%2CCOUNTY&returnGeometry=false&resultRecordCount=100&orderByFields=GEOID&f=json",
    "unwrap_attributes": true,
    "criteria": "California counties, attributes only; omit polygon geometry and avoid TIGER ZIP archives.",
    "documentation": "https://tigerweb.geo.census.gov/arcgis/rest/services/TIGERweb/State_County/MapServer"
  },
  "normalization": {
    "adapter_version": 1,
    "input_format": "sampled_jsonl",
    "raw_fields": "preserved in attributes.source_row",
    "entity_identity": "source IDs, canonical geography, explicitly labeled unresolved references and aggregate cohorts",
    "coverage": "acquired sample only"
  },
  "acquisition": {
    "strategy": "files",
    "description": "2024 Gazetteer files (land/water area, internal points) for counties, places, CBSAs, tracts and ZCTAs plus 2024 cartographic boundary 1:500k shapefiles for states, counties, CBSAs, CSAs, places and tracts (ZCTA polygons from 2020 release)",
    "desired_bytes": 190000000,
    "priority": 3.0,
    "files": [
      {
