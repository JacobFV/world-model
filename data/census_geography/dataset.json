        "name": "cb_2024_us_state_500k.zip"
      },
      {
        "url": "https://www2.census.gov/geo/tiger/GENZ2024/shp/cb_2024_us_county_500k.zip",
        "name": "cb_2024_us_county_500k.zip"
      },
      {
        "url": "https://www2.census.gov/geo/tiger/GENZ2024/shp/cb_2024_us_cbsa_500k.zip",
        "name": "cb_2024_us_cbsa_500k.zip"
      },
      {
        "url": "https://www2.census.gov/geo/tiger/GENZ2024/shp/cb_2024_us_csa_500k.zip",
