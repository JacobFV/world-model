{
  "id": "county_panel",
  "schema_version": 2,
  "kind": "derived",
  "status": "published_by_embedding_layer",
  "description": "Dated US county panel (county x feature x year, each value with the date it became public) and dated county edges (IRS migration flows, CBSA membership), assembled from published normalized datasets. Written by 'wm embed-panel', not by a stage pipeline.",
  "dependencies": ["bls_labor", "bea_national_regional", "noaa_climdiv", "noaa_storm_events", "openfema", "census_geography", "irs_soi_migration", "cbsa_delineations"],
  "entrypoint": "pipeline.py:run",
  "parameters": {
    "producer": "worldmodel.embedding.county_panel:build",
    "command": "python3 -m worldmodel embed-panel"
  },
  "stages": [
    {
      "id": "final",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {"format": "jsonl"},
      "validation": {"allow_empty": false, "max_rows": 20000000},
      "cache": "off",
      "retention": "retain"
    }
  ],
  "output_stage": "final"
}
