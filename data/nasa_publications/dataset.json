{
  "id": "nasa_publications",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "complete",
  "description": "NASA.gov main RSS feed, pages 1-20 (~200 most recent posts): publication metadata as publisher claims",
  "source": {
    "publisher": "NASA",
    "documentation": "https://www.nasa.gov/rss-feeds/",
    "license_status": "public_domain_most_content",
    "license_notes": "NASA content is generally not copyrighted (US government work); some third-party images/text excepted. Only feed metadata is normalized."
  },
  "entrypoint": "pipeline.py:run",
  "sampling": {
    "strategy": "download",
    "url": "https://www.nasa.gov/feed/",
    "documentation": "https://www.nasa.gov/rss-feeds/",
    "format": "rss",
    "records_path": [],
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 20,
    "total_timeout_seconds": 40,
    "representative": false,
    "criteria": "One explicit first-page request; up to100 matching rows. No pagination, no completeness claim."
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 10000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized",
  "acquisition": {
    "strategy": "url_list",
    "description": "WordPress paged RSS: https://www.nasa.gov/feed/?paged={page} for pages 1..20 (10 items per page, ~280 KB per page measured 2026-09-15)",
    "documentation": "https://www.nasa.gov/rss-feeds/",
    "desired_bytes": 6500000,
    "priority": 1.0,
    "url_template": "https://www.nasa.gov/feed/?paged={page}",
    "parameters": {
      "page": {
        "range": [
          1,
          20
        ]
      }
    },
    "skip_statuses": [
      404
    ],
    "rate_limit": {
      "requests_per_second": 0.5
    }
  },
  "coverage": {
    "representative": false,
    "completeness": "complete_for_declared_scope",
    "scope": "NASA.gov main feed pages 1-20 (200 posts) at acquisition time"
  }
}
