{
  "id": "natural_experiment_reports",
  "schema_version": 2,
  "kind": "derived",
  "status": "published_by_causal_layer",
  "description": "Pre-registered natural-experiment results (staggered difference-in-differences and held-out exposure-ranking tests) published by worldmodel.causal from the event library and pinned outcome datasets. Written by examples/natural-experiments/run_studies.py, not by a stage pipeline.",
  "dependencies": [],
  "entrypoint": "pipeline.py:run",
  "parameters": {
    "producer": "worldmodel.causal.studies",
    "registrations": "examples/natural-experiments/registrations",
    "command": "python3 examples/natural-experiments/run_studies.py"
  },
  "stages": [
    {
      "id": "final",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "jsonl"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 100000
      },
      "cache": "off",
      "retention": "retain"
    }
  ],
  "output_stage": "final"
}
