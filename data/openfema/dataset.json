{
  "id": "openfema",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_configured",
  "description": "OpenFEMA: disaster declarations by designated county/area, per-disaster financial summaries, Public Assistance funded project summaries by applicant, and Individuals and Households Program housing assistance for owners and renters by county/ZIP",
  "source": {
    "publisher": "Federal Emergency Management Agency (OpenFEMA)",
    "documentation": "https://www.fema.gov/about/openfema/data-sets",
    "license_status": "public_domain",
    "license_notes": "US federal government work: public domain in the United States (17 U.S.C. 105); no redistribution restriction; cite the publisher. OpenFEMA terms: data are provided as-is, must not be used to imply FEMA endorsement; datasets are refreshed and values change as obligations are updated."
  },
  "entrypoint": "pipeline.py:run",
  "parameters": {},
  "sampling": {
    "criteria": "First 100 records, at most 1 MiB",
    "disk_budget_bytes": 67108864,
    "format": "jsonl",
    "max_download_bytes": 1048576,
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "reason": "Configure a documented source URL and format before acquisition",
    "strategy": "blocked"
  },
  "acquisition": {
    "strategy": "paged_api",
    "description": "OpenFEMA API $format=jsona pages of 10,000 records with $select field subsets, ordered by id for stable $skip paging",
    "documentation": "https://www.fema.gov/about/openfema/api",
    "desired_bytes": 210000000,
    "priority": 2.0,
    "url_template": "https://www.fema.gov/api/open/{version}/{entity}?$format=jsona&$orderby=id&$select={select}",
    "combinations": [
      {
        "version": "v2",
        "entity": "DisasterDeclarationsSummaries",
        "select": "femaDeclarationString,disasterNumber,state,declarationType,declarationDate,fyDeclared,incidentType,declarationTitle,ihProgramDeclared,iaProgramDeclared,paProgramDeclared,hmProgramDeclared,incidentBeginDate,incidentEndDate,disasterCloseoutDate,tribalRequest,fipsStateCode,fipsCountyCode,placeCode,designatedArea,declarationRequestDate,region,designatedIncidentTypes"
      },
      {
        "version": "v1",
        "entity": "FemaWebDisasterSummaries",
        "select": "disasterNumber,totalNumberIaApproved,totalAmountIhpApproved,totalAmountHaApproved,totalAmountOnaApproved,totalObligatedAmountPa,totalObligatedAmountCatAb,totalObligatedAmountCatC2g,totalObligatedAmountHmgp"
      },
      {
        "version": "v1",
        "entity": "PublicAssistanceFundedProjectsSummaries",
        "select": "disasterNumber,declarationDate,incidentType,state,county,applicantName,educationApplicant,numberOfProjects,federalObligatedAmount"
      },
      {
        "version": "v2",
        "entity": "HousingAssistanceOwners",
        "select": "disasterNumber,state,county,zipCode,validRegistrations,averageFemaInspectedDamage,totalInspected,totalDamage,noFemaInspectedDamage,approvedForFemaAssistance,totalApprovedIhpAmount,repairReplaceAmount,rentalAmount,otherNeedsAmount,totalMaxGrants"
      },
      {
        "version": "v2",
        "entity": "HousingAssistanceRenters",
        "select": "disasterNumber,state,county,zipCode,validRegistrations,totalInspected,approvedForFemaAssistance,totalApprovedIhpAmount,repairReplaceAmount,rentalAmount,otherNeedsAmount,totalMaxGrants"
      }
    ],
    "pagination": {
      "mode": "offset",
      "param": "$skip",
      "size_param": "$top",
      "page_size": 10000,
      "start": 0
    },
    "records_path": [],
    "stop": {
      "short_page": true,
      "empty_page": true
    },
    "store": "jsonl",
    "rollover_bytes": 134217728,
    "rate_limit": {
      "requests_per_second": 0.5
    },
    "timeout_seconds": 240,
    "retries": 6,
    "reader": {
      "format": "jsonl"
    }
  },
  "stages": [
    {
      "cache": "content",
      "depends_on": [],
      "entrypoint": "pipeline.py:run",
      "id": "normalized",
      "retention": "retain",
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 8000000
      }
    }
  ],
  "output_stage": "normalized"
}
