{
  "id": "opm_fedscope",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_configured",
  "description": "OPM FedScope cubes, 1998-2024: the de-identified federal civilian workforce, one source row per employee (63 quarterly employment cubes, September 1998 to June 2022) and per hire or separation (8 five-fiscal-year accession and separation cubes, FY2005-FY2024), aggregated while streaming into agency x duty state, agency x occupational series, agency x pay plan and grade, and the agency and state totals, with headcount, published annual salary total, and the count of employees whose salary was published",
  "source": {
    "publisher": "U.S. Office of Personnel Management, Enterprise Human Resources Integration (EHRI)",
    "license_status": "public_domain_us_government",
    "documentation": "https://www.opm.gov/data/datasets/Index.aspx?tag=FedScope",
    "license_notes": "US federal government work: public domain in the United States (17 U.S.C. 105); no redistribution restriction; cite the publisher. OPM's public cube is a de-identified extract of EHRI: salary is the annual basic pay rate, age and length of service are banded, and duty location is a state. Salary is blank for a material share of rows (12.6% of the June 2022 employment cube, measured); those rows count toward headcount and not toward the salary total, and the published-salary denominator is emitted so no mean is implied where none can be computed. Employment cube coverage is quarterly from March 2010 and annual (September) before that; the public series stops at June 2022 as published on the OPM datasets page.",
    "person_level_records": {
      "policy": "prohibited",
      "authority": "5 U.S.C. 552a; OPM FedScope de-identification",
      "note": "OPM publishes no identified natural persons in these cubes: a fact row is an employee with no name, no date of birth, no duty address and no identifier, and age and length of service are banded. There is nothing identified to retain, so the restrictive default costs this dataset nothing and no permission is claimed. Named federal salary rosters come from FOIA aggregators rather than OPM and are out of scope."
    }
  },
  "expected_outputs": [
    "federal_employees",
    "federal_annual_salary_total",
    "federal_accessions",
    "federal_separations"
  ],
  "setup": "One shard per cube, named fedscope_<kind>_<period>.zip so the pipeline reads the cube kind and period deterministically. Decode codes from the DT*.txt tables inside each archive; never assume a dimension table is shared across vintages.",
  "entrypoint": "pipeline.py:run",
  "output_stage": "normalized",
  "parameters": {},
  "sampling": {
    "strategy": "blocked",
    "reason": "Full acquisition only (wm acquire opm_fedscope): a fact row is meaningless without the DT*.txt dimension tables packaged in the same archive, and the pipeline aggregates whole cubes.",
    "criteria": "First 100 records, at most 1 MiB",
    "format": "jsonl",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 30000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "acquisition": {
    "strategy": "files",
    "description": "71 FedScope cube archives from the OPM datasets library: 63 employment cubes (September 1998-2009 annually, then quarterly March 2010-June 2022) and 8 accession/separation cubes covering FY2005-FY2024 in five-year blocks. Each archive holds one fact file (FACTDATA/ACCDATA/SEPDATA, 81-153 MB uncompressed) plus its DT*.txt dimension tables and documentation PDF. Declared sizes on the OPM page total 1.372 GiB.",
    "documentation": "https://www.opm.gov/data/datasets/Index.aspx?tag=FedScope",
    "desired_bytes": 1800000000,
    "min_bytes": 0,
    "priority": 2.0,
    "rate_limit": {
      "requests_per_second": 0.5
    },
    "timeout_seconds": 300,
