{
  "id": "osm_topology",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_ready",
  "description": "OpenStreetMap network topology for the western United States (Geofabrik US West extract, a superset of California): simplified road, rail, power-line, pipeline and ferry edges between intersection/endpoint nodes, plus transport and energy facilities; the sampling block keeps the bounded San Francisco Overpass excerpt",
  "source": {
    "publisher": "OpenStreetMap contributors via Geofabrik GmbH",
    "license_status": "open_share_alike",
    "license": "ODbL-1.0",
    "license_url": "https://opendatacommons.org/licenses/odbl/1-0/",
    "attribution": "(c) OpenStreetMap contributors, https://www.openstreetmap.org/copyright",
    "license_notes": "Attribution required; a publicly distributed derived database must be offered under ODbL (share-alike). Produced works need attribution only.",
    "release": "us-west-260914.osm.pbf (replication snapshot 2026-09-14)"
  },
  "entrypoint": "pipeline.py:run",
  "parameters": {
    "workers": 12,
    "edge_geometry": true
  },
  "sampling": {
    "strategy": "download",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 25,
    "total_timeout_seconds": 90,
    "format": "json",
    "representative": false,
    "url": "https://overpass-api.de/api/interpreter?data=%5Bout%3Ajson%5D%5Btimeout%3A20%5D%5Bmaxsize%3A1048576%5D%3Bway%5B%22highway%22%5D%2837.774%2C-122.420%2C37.777%2C-122.416%29%3Bout+geom+100%3B",
    "criteria": "First100 highway ways in a small San Francisco bounding box; full node IDs and geometry per retained way; bounded subgraph, not global coverage",
    "records_path": [
      "elements"
    ],
    "documentation": "https://wiki.openstreetmap.org/wiki/Overpass_QL"
  },
  "acquisition": {
    "strategy": "files",
    "description": "Geofabrik US West OpenStreetMap extract (dated snapshot 2026-09-14, 3,400,591,554 bytes, md5 09b41da4f8d8b3eb4a46074d33384e60), decoded by the dataset-local streaming PBF reader. The superseded California artifact was retired after this build verified.",
    "documentation": "https://download.geofabrik.de/north-america/us-west.html",
    "desired_bytes": 3410000000,
    "min_bytes": 0,
    "priority": 3.0,
    "files": [
      {
        "url": "https://download.geofabrik.de/north-america/us-west-260914.osm.pbf",
        "name": "us-west-260914.osm.pbf"
      }
    ],
    "rate_limit": {
      "requests_per_second": 0.2
    },
    "timeout_seconds": 600,
    "retries": 8
  },
  "stages": [
    {
      "id": "parsed",
      "entrypoint": "pipeline.py:parse",
      "depends_on": [],
      "schema": {
        "format": "jsonl",
        "compression": "gzip",
        "required": {
          "type": "string"
        }
      },
      "validation": {
        "allow_empty": true,
        "max_rows": 80000000
      },
      "cache": "content",
      "retention": "rebuildable"
    },
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [
        "parsed"
      ],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 80000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized"
}
