{
  "id": "treasury_debt",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "full_acquisition_configured",
  "description": "U.S. Treasury Fiscal Service: Debt to the Penny (1993+), historical debt outstanding, average interest rates on Treasury securities, Monthly Treasury Statement tables 1-6, 8, 9 and Daily Treasury Statement tables (2005+) via the fiscaldata API",
  "source": {
    "publisher": "U.S. Department of the Treasury, Bureau of the Fiscal Service",
    "license_status": "public_domain_us_government",
    "license_notes": "U.S. federal government work (17 U.S.C. 105); no redistribution restriction. Fiscal Data terms: https://fiscaldata.treasury.gov/about-us/"
  },
  "entrypoint": "pipeline.py:run",
  "parameters": {},
  "sampling": {
    "strategy": "download",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 65011712,
    "max_uncompressed_bytes": 65011712,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 25,
    "total_timeout_seconds": 90,
    "format": "json",
    "representative": false,
    "url": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service/v2/accounting/od/debt_to_penny?filter=record_date%3Agte%3A2025-01-01%2Crecord_date%3Alte%3A2025-03-31&page%5Bsize%5D=100&sort=record_date",
    "criteria": "Daily federal debt stocks, Jan–Mar 2025; first100 rows",
    "records_path": [
      "data"
    ],
    "documentation": "https://fiscaldata.treasury.gov/api-documentation/"
  },
  "acquisition": {
    "strategy": "paged_api",
    "description": "Full history of selected fiscaldata tables, one JSON page (10,000 rows, selected fields only) per shard. The Treasury par yield curve is not acquired here: fred_macro_panel carries the H.15 constant-maturity curve (DGS1MO..DGS30).",
    "documentation": "https://fiscaldata.treasury.gov/api-documentation/",
    "desired_bytes": 300000000,
    "min_bytes": 0,
    "priority": 3.0,
    "url_template": "https://api.fiscaldata.treasury.gov/services/api/fiscal_service/{version}/accounting/{group}/{table}?format=json&sort=record_date,src_line_nbr&fields={fields}",
    "combinations": [
      {"version": "v2", "group": "od", "table": "debt_to_penny", "fields": "record_date,tot_pub_debt_out_amt,debt_held_public_amt,intragov_hold_amt,src_line_nbr"},
      {"version": "v2", "group": "od", "table": "debt_outstanding", "fields": "record_date,debt_outstanding_amt,src_line_nbr"},
      {"version": "v2", "group": "od", "table": "avg_interest_rates", "fields": "record_date,security_type_desc,security_desc,avg_interest_rate_amt,src_line_nbr"},
      {"version": "v1", "group": "mts", "table": "mts_table_1", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_gross_rcpt_amt,current_month_gross_outly_amt,current_month_dfct_sur_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_2", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_budget_amt,current_fytd_budget_amt,current_year_budget_est_amt,next_year_budget_est_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_3", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_rcpt_outly_amt,current_fytd_rcpt_outly_amt,current_year_budget_est_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_4", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_gross_rcpt_amt,current_month_refund_amt,current_month_net_rcpt_amt,current_fytd_net_rcpt_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_5", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_gross_outly_amt,current_month_app_rcpt_amt,current_month_net_outly_amt,current_fytd_net_outly_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_6", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_net_txn_amt,fytd_net_txn_amt,close_month_acct_bal_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_8", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_rcpt_amt,current_month_outly_amt,current_month_excess_amt,close_month_acct_bal_amt"},
      {"version": "v1", "group": "mts", "table": "mts_table_9", "fields": "record_date,parent_id,classification_id,classification_desc,table_nbr,src_line_nbr,line_code_nbr,data_type_cd,record_type_cd,sequence_level_nbr,sequence_number_cd,current_month_rcpt_outly_amt,current_fytd_rcpt_outly_amt"},
      {"version": "v1", "group": "dts", "table": "operating_cash_balance", "fields": "record_date,account_type,close_today_bal,open_today_bal,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "public_debt_transactions", "fields": "record_date,transaction_type,security_market,security_type,security_type_desc,transaction_today_amt,table_nbr,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "adjustment_public_debt_transactions_cash_basis", "fields": "record_date,transaction_type,adj_type,adj_type_desc,adj_today_amt,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "debt_subject_to_limit", "fields": "record_date,debt_catg,debt_catg_desc,close_today_bal,open_today_bal,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "federal_tax_deposits", "fields": "record_date,tax_deposit_type,tax_deposit_type_desc,tax_deposit_today_amt,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "short_term_cash_investments", "fields": "record_date,transaction_type,transaction_type_desc,total_amt,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "income_tax_refunds_issued", "fields": "record_date,tax_refund_type,tax_refund_type_desc,tax_refund_today_amt,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "inter_agency_tax_transfers", "fields": "record_date,classification,today_amt,table_nbr,sub_table_name,src_line_nbr"},
      {"version": "v1", "group": "dts", "table": "deposits_withdrawals_operating_cash", "fields": "record_date,account_type,transaction_type,transaction_catg,transaction_catg_desc,transaction_today_amt,table_nbr,src_line_nbr"}
    ],
    "pagination": {
      "mode": "page",
      "param": "page[number]",
      "size_param": "page[size]",
      "page_size": 10000,
      "start": 1,
      "location": "query"
    },
    "records_path": ["data"],
    "stop": {
      "total_pages_path": ["meta", "total-pages"],
      "empty_page": true,
      "short_page": true
    },
    "store": "pages",
    "rate_limit": {
      "requests_per_second": 1.0,
      "key": "api.fiscaldata.treasury.gov"
    },
    "timeout_seconds": 240,
    "retries": 6,
    "reader": {
      "format": "json",
      "records_path": ["data"]
    }
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 5000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized"
}
