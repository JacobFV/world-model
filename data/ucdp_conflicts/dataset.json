{
  "id": "ucdp_conflicts",
  "schema_version": 2,
  "dependencies": [],
  "kind": "source",
  "status": "requires_source_token",
  "description": "UCDP reported organized-violence events; bounded source estimates with uncertain dates/effects.",
  "source": {
    "publisher": "Uppsala Conflict Data Program",
    "documentation": "https://ucdp.uu.se/apidocs/",
    "license_status": "retain publisher/source terms; metadata does not grant content redistribution"
  },
  "entrypoint": "pipeline.py:run",
  "sampling": {
    "strategy": "download",
    "url": "https://ucdpapi.pcr.uu.se/api/gedevents/26.1?pagesize=5&page=1",
    "documentation": "https://ucdp.uu.se/apidocs/",
    "format": "json",
    "records_path": [
      "Result"
    ],
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 20,
    "total_timeout_seconds": 40,
    "representative": false,
    "criteria": "One explicit first-page request; up to100 matching rows. No pagination, no completeness claim.",
    "headers_env": {
      "x-ucdp-access-token": "UCDP_ACCESS_TOKEN"
    }
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 100000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized"
}
