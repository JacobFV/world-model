{
  "id": "usaspending",
  "schema_version": 2,
  "kind": "source",
  "status": "full_acquisition_complete",
  "description": "USAspending prime contract transactions for all agencies, FY2025 and FY2026 (full award data archives)",
  "source": {
    "publisher": "U.S. Department of the Treasury, Bureau of the Fiscal Service / USAspending.gov",
    "license_status": "public_domain_us_government_work",
    "documentation": "https://files.usaspending.gov/award_data_archive/",
    "license_notes": "US federal government work; no redistribution restriction. Recipient officer compensation names are present in raw files and are not emitted."
  },
  "dependencies": [],
  "expected_outputs": [
    "organization",
    "contract",
    "award",
    "payment"
  ],
  "setup": "Normalize award and transaction IDs; distinguish obligations from outlays and avoid double-counting totals.",
  "entrypoint": "pipeline.py:run",
  "parameters": {},
  "sampling": {
    "strategy": "download",
    "max_rows": 100,
    "max_sample_bytes": 1048576,
    "max_download_bytes": 1048576,
    "max_uncompressed_bytes": 1048576,
    "disk_budget_bytes": 67108864,
    "timeout_seconds": 25,
    "total_timeout_seconds": 90,
    "format": "json",
    "records_path": [
      "results"
    ],
    "representative": false,
    "url": "https://api.usaspending.gov/api/v2/search/spending_by_award/",
    "method": "POST",
    "body": {
      "filters": {
        "time_period": [
          {
            "start_date": "2024-01-01",
            "end_date": "2024-01-31"
          }
        ],
        "award_type_codes": [
          "A",
          "B",
          "C",
          "D"
        ]
      },
      "fields": [
        "Award ID",
        "Recipient Name",
        "Award Amount",
        "Awarding Agency"
      ],
      "page": 1,
      "limit": 100,
      "sort": "Award Amount",
      "order": "desc"
    },
    "criteria": "First 100 contract awards by amount for January 2024; award summaries, not all transactions.",
    "documentation": "https://api.usaspending.gov/docs/endpoints"
  },
  "normalization": {
    "adapter_version": 1,
    "input_format": "sampled_jsonl",
    "raw_fields": "preserved in attributes.source_row",
    "entity_identity": "source IDs, canonical geography, explicitly labeled unresolved references and aggregate cohorts",
    "coverage": "acquired sample only"
  },
  "stages": [
    {
      "id": "normalized",
      "entrypoint": "pipeline.py:run",
      "depends_on": [],
      "schema": {
        "format": "evidence_jsonl",
        "compression": "gzip"
      },
      "validation": {
        "allow_empty": false,
        "max_rows": 250000000
      },
      "cache": "content",
      "retention": "retain"
    }
  ],
  "output_stage": "normalized",
  "acquisition": {
    "strategy": "files",
    "description": "FY2025 and FY2026 All-agency Contracts Full archives (CSV members of up to 1M rows each). Archives are rebuilt monthly; the dated file names must be updated to refresh.",
    "documentation": "https://files.usaspending.gov/award_data_archive/?prefix=FY2026_All_Contracts",
    "desired_bytes": 4150000000,
    "priority": 2.0,
    "files": [
      {
        "url": "https://files.usaspending.gov/award_data_archive/FY2026_All_Contracts_Full_20260906.zip",
        "name": "FY2026_All_Contracts_Full_20260906.zip"
      },
      {
        "url": "https://files.usaspending.gov/award_data_archive/FY2025_All_Contracts_Full_20260906.zip",
        "name": "FY2025_All_Contracts_Full_20260906.zip"
      }
    ],
    "rate_limit": {
      "requests_per_second": 1.0
    },
    "timeout_seconds": 120,
    "retries": 8,
    "reader": {
      "format": "csv",
      "members": [
        "*.csv"
      ]
    }
  }
}
