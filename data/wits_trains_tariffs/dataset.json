{
 "id": "wits_trains_tariffs",
 "schema_version": 2,
 "kind": "source",
 "status": "full_acquisition_complete",
 "description": "WITS/UNCTAD TRAINS MFN applied tariffs (HS6 simple averages of national tariff lines, partner 000 = all MFN partners) for 59 large economies (EU as one customs union), every reported year 2018-2023",
 "dependencies": [],
 "parameters": {},
 "entrypoint": "pipeline.py:run",
 "output_stage": "normalized",
 "source": {
  "publisher": "World Bank WITS / UNCTAD TRAINS",
  "documentation": "https://wits.worldbank.org/witsapiintro.aspx",
  "terms_url": "https://wits.worldbank.org/about_wits.html",
  "license": "WITS/TRAINS terms: free use with attribution; no resale",
  "license_id": "wits-trains-terms",
  "license_status": "attribution_required_no_resale",
  "attribution": "UNCTAD TRAINS via World Bank WITS",
  "redistribution": "restricted",
  "reporter_selection": "G20 + large/regional trading economies; latest available year probed 2026-09-15 per reporter (see acquisition.combinations)"
 },
 "acquisition": {
  "strategy": "url_list",
  "description": "One SDMX GenericData request per reporter-year: all HS6 products, partner 000 (MFN), DATATYPE=reported, for every year 2018..latest that each reporter actually reports (332 reporter-years, ~5.2 MB each). Reported-year availability was probed 2026-09-15 per reporter; re-probe before refreshing. desired_bytes covers the ~1.7 GB new grid plus the retained ~0.3 GB latest-year-only artifact. Requires an Accept header (WITS returns 500 without it); endperiod=2026 returns 500; multi-year all-product queries are refused as too large.",
  "documentation": "https://wits.worldbank.org/data/public/WITSAPI_UserGuide.pdf",
  "desired_bytes": 2200000000,
  "min_bytes": 0,
  "priority": 3.0,
  "url_template": "https://wits.worldbank.org/API/V1/SDMX/V21/rest/data/DF_WITS_Tariff_TRAINS/A.{reporter}.000..reported/?startperiod={year}&endperiod={year}",
