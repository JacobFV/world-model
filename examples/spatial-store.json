{
  "description": "Synthetic support lifecycle demonstration. Cartesian positions are explicit kilometers; coefficients are illustrative and uncalibrated.",
  "coordinate_system": {"kind": "cartesian", "axes": ["x", "y"], "unit": "km"},
  "world": {
    "description": "Three synthetic supports with conserved stock and measure-weighted density.",
    "measure_unit": "km2",
    "cells": [
      {"id": "cell:west", "measure": 2, "coordinates": [0, 0]},
      {"id": "cell:center", "measure": 1, "coordinates": [1, 0]},
      {"id": "cell:east", "measure": 3, "coordinates": [2, 0]}
    ],
    "edges": [
      {"id": "edge:west-center", "source": "cell:west", "target": "cell:center", "conductance": 0.01},
      {"id": "edge:center-east", "source": "cell:center", "target": "cell:east", "conductance": 0.02}
    ],
    "fields": {
      "stock": {"kind": "extensive", "unit": "kg", "values": {"cell:west": 12, "cell:center": 3, "cell:east": 0}},
      "density": {"kind": "intensive", "unit": "kg/km2", "values": {"cell:west": 6, "cell:center": 3, "cell:east": 0}}
    },
    "claims": [
      {"id": "claim:example", "claimant": "actor:example", "cells": ["cell:west"], "label": "Fictional unresolved claim"}
    ]
  },
  "events": [
    {"type": "merge", "cells": ["cell:west", "cell:center"], "cell": {"id": "cell:merged", "measure": 3, "coordinates": [0.5, 0]}},
    {"type": "split", "cell": "cell:merged", "children": [
      {"id": "cell:part1", "measure": 1, "coordinates": [0, 0]},
      {"id": "cell:part2", "measure": 2, "coordinates": [1, 0]}
    ], "edges": [
      {"id": "edge:parts", "source": "cell:part1", "target": "cell:part2", "conductance": 0.01},
      {"id": "edge:part2-east", "source": "cell:part2", "target": "cell:east", "conductance": 0.02}
    ]}
  ],
  "selection": {"cells": ["cell:part1", "cell:part2", "cell:east"], "limit": 100},
  "evolution": {"duration_seconds": 60, "step_seconds": 1, "max_substeps": 100, "max_work": 10000}
}
